---
interface Props {
  name: string;
  class?: string;
  draw?: boolean;
}
const { name, class: className = 'h-6 w-6', draw = false } = Astro.props;

const paths: Record<string, string[]> = {
  // Produto
  connect: ['M4 12h5', 'M15 12h5', 'M9 8.5v7a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1Z'],
  settle: ['M3 7h13l-3-3', 'M21 17H8l3 3', 'M3 12h18'],
  globe: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z', 'M3.6 9h16.8', 'M3.6 15h16.8', 'M12 3c2.5 2.4 3.8 5.4 3.8 9S14.5 18.6 12 21c-2.5-2.4-3.8-5.4-3.8-9S9.5 5.4 12 3Z'],
  code: ['M9 8l-4 4 4 4', 'M15 8l4 4-4 4'],
  // Segurança
  shield: ['M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3Z', 'M9 12.2l2.1 2.1L15.5 10'],
  trace: ['M4 18h16', 'M4 18l4-6 3 3 4-7 5 4', 'M4 6v12'],
  lock: ['M6 11h12v9H6z', 'M9 11V8a3 3 0 0 1 6 0v3', 'M12 15v2'],
  pulse: ['M3 12h4l2-5 3 10 2-5h7'],
  // Infra
  layers: ['M12 4l8 4-8 4-8-4 8-4Z', 'M4 12l8 4 8-4', 'M4 16l8 4 8-4'],
  spark: ['M12 3v4', 'M12 17v4', 'M3 12h4', 'M17 12h4', 'M6 6l2.5 2.5', 'M15.5 15.5L18 18', 'M18 6l-2.5 2.5', 'M8.5 15.5L6 18'],
  arrow: ['M5 12h14', 'M13 6l6 6-6 6'],
  check: ['M5 12.5l4.5 4.5L19 7'],
};

const d = paths[name] ?? paths.arrow;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-draw={draw ? '' : undefined}
>
  {d.map((p) => <path d={p} />)}
</svg>
