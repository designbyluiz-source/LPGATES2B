---
import { comoFunciona as c } from '../../data/content';
---

<section
  id="como-funciona"
  data-theme-section="light"
  data-rail
  class="relative flex min-h-screen flex-col justify-center overflow-hidden bg-paper-100 py-24 text-ink-950 lg:py-0"
>
  <div class="container-lp relative w-full">
    <div class="max-w-3xl">
      <h2 data-split="lines" class="display-lg text-ink-950">{c.title}</h2>
    </div>

    <!-- Trilho de progresso -->
    <div class="relative mt-12 h-px w-full bg-ink-950/10 lg:mt-16" aria-hidden="true">
      <div
        data-rail-progress
        class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-linear-to-r from-brand-500 to-brand-300"
      >
      </div>
    </div>
  </div>

  <!-- Trilho horizontal -->
  <div class="relative mt-12 w-full overflow-hidden lg:mt-16">
    <div
      data-rail-track
      class="flex flex-col gap-5 px-6 lg:flex-row lg:gap-8 lg:px-10"
    >
      {
        c.steps.map((s) => (
          <article
            data-rail-card
            class="card-light group relative flex shrink-0 flex-col justify-between overflow-hidden p-8 lg:h-[24rem] lg:w-[26rem] lg:p-10"
          >
            <div class="flex items-center justify-between gap-4">
              {/* O número é um marcador de etapa, não textura de fundo: azul da
                  marca, em tamanho que se lê de relance. Antes era um numeral
                  gigante em cinza claro, praticamente invisível. */}
              <div class="flex items-center gap-4">
                <span
                  class="font-display text-2xl leading-none font-semibold tracking-tight text-brand-500"
                >
                  {s.n}
                </span>
                <span class="h-px w-10 bg-brand-500/30 transition-all duration-500 group-hover:w-16 group-hover:bg-brand-500"></span>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink-950/12 text-ink-950/40 transition-all duration-500 group-hover:border-brand-500 group-hover:bg-brand-500 group-hover:text-white">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>

            <div class="mt-8 lg:mt-0">
              <h3 class="font-display text-2xl font-medium tracking-tight text-ink-950 lg:text-[2rem]">
                {s.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-ink-950/70">{s.description}</p>
              {/* 55%: mínimo para 4,5:1 sobre branco em texto de 14px */}
              <p class="mt-6 border-t border-ink-950/10 pt-6 text-[0.875rem] leading-relaxed text-ink-950/55">
                {s.detail}
              </p>
            </div>
          </article>
        ))
      }
      <!-- respiro final do trilho -->
      <div class="hidden shrink-0 lg:block lg:w-10" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  /* As cartas inativas do trilho são escurecidas por um véu sobreposto, e não
     por `opacity` no card. O resultado na tela é idêntico — o véu usa a cor de
     fundo da seção, então compõe exatamente a mesma cor final — mas a cor
     computada do texto continua sendo a real. Com `opacity` no card, auditorias
     de contraste leem o texto já esmaecido e reprovam um estado que é
     transitório e decorativo. */
  [data-rail-card] {
    --dim: 0;
  }
  [data-rail-card]::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    background: var(--color-paper-100);
    opacity: var(--dim);
    pointer-events: none;
  }

  /* 0.42 e não 0.68: escurecer demais tornava as cartas seguintes ilegíveis.
     O suficiente para hierarquizar a carta ativa, sem apagar as outras. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    [data-rail-card] {
      --dim: 0.42;
    }
  }
  @media (max-width: 1023px) {
    :global(html.js) [data-rail-card] {
      opacity: 0;
      transform: translateY(28px);
    }
  }
</style>
