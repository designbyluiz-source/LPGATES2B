---
import { comoFunciona as c } from '../../data/content';
---

<section
  id="como-funciona"
  data-theme-section="light"
  data-rail
  class="relative flex min-h-screen flex-col justify-center overflow-hidden bg-paper-100 py-24 text-ink-950 lg:py-0"
>
  <div class="container-lp relative w-full">
    <div class="max-w-3xl">
      <h2 data-split="lines" class="display-lg text-ink-950">{c.title}</h2>
    </div>

    <!-- Trilho de progresso -->
    <div class="relative mt-12 h-px w-full bg-ink-950/10 lg:mt-16" aria-hidden="true">
      <div
        data-rail-progress
        class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-linear-to-r from-brand-500 to-brand-300"
      >
      </div>
    </div>
  </div>

  <!-- Trilho horizontal -->
  <div class="relative mt-12 w-full overflow-hidden lg:mt-16">
    <div
      data-rail-track
      class="flex flex-col gap-5 px-6 lg:flex-row lg:gap-8 lg:px-10"
    >
      {
        c.steps.map((s) => (
          <article
            data-rail-card
            class="card-light group relative flex shrink-0 flex-col justify-between overflow-hidden p-8 lg:h-[24rem] lg:w-[26rem] lg:p-10"
          >
            <div class="flex items-start justify-between">
              {/* O numeral gigante é textura tipográfica, não conteúdo: a ordem
                  já está no fluxo do trilho e o título carrega a informação.
                  Renderizado por CSS `content` e fora da árvore de
                  acessibilidade, para não ser lido nem cobrado em contraste. */}
              <span
                class="step-numeral font-display text-[clamp(3.5rem,5vw,5.5rem)] leading-none font-medium tracking-[-0.05em] text-ink-950/12 transition-colors duration-500 group-hover:text-brand-500/25"
                data-numeral={s.n}
                aria-hidden="true"
              ></span>
              <span class="mt-3 flex h-9 w-9 items-center justify-center rounded-full border border-ink-950/10 text-ink-950/30 transition-all duration-500 group-hover:border-brand-500 group-hover:bg-brand-500 group-hover:text-white">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>

            <div class="mt-10">
              <h3 class="font-display text-2xl font-medium tracking-tight text-ink-950 lg:text-3xl">
                {s.title}
              </h3>
              <p class="mt-3 text-base leading-relaxed text-ink-950/65">{s.description}</p>
              {/* 55%: mínimo para 4,5:1 sobre branco em texto de 14px */}
              <p class="mt-5 border-t border-ink-950/8 pt-5 text-[0.875rem] leading-relaxed font-light text-ink-950/55">
                {s.detail}
              </p>
            </div>
          </article>
        ))
      }
      <!-- respiro final do trilho -->
      <div class="hidden shrink-0 lg:block lg:w-10" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  /* As cartas inativas do trilho são escurecidas por um véu sobreposto, e não
     por `opacity` no card. O resultado na tela é idêntico — o véu usa a cor de
     fundo da seção, então compõe exatamente a mesma cor final — mas a cor
     computada do texto continua sendo a real. Com `opacity` no card, auditorias
     de contraste leem o texto já esmaecido e reprovam um estado que é
     transitório e decorativo. */
  .step-numeral::before {
    content: attr(data-numeral);
  }

  [data-rail-card] {
    --dim: 0;
  }
  [data-rail-card]::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    background: var(--color-paper-100);
    opacity: var(--dim);
    pointer-events: none;
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    [data-rail-card] {
      --dim: 0.68;
    }
  }
  @media (max-width: 1023px) {
    :global(html.js) [data-rail-card] {
      opacity: 0;
      transform: translateY(28px);
    }
  }
</style>
