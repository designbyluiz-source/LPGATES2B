---
import { hero } from '../../data/content';
---

<section
  data-hero-section
  class="texture relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-ink-950 pt-28 pb-8 lg:pt-32"
>
  <!-- Imagem de fundo (F1 noturno, tratado nas cores da marca).
       z-0 (e não -z-*): índice negativo jogaria a imagem atrás do bg da seção. -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <picture data-hero-media class="block h-full w-full">
      <source media="(min-width: 1024px)" srcset="/img/hero-f1-2400.webp" />
      <img
        src="/img/hero-f1-1600.webp"
        alt=""
        aria-hidden="true"
        width="2400"
        height="1360"
        fetchpriority="high"
        decoding="async"
        class="hero-media-in h-full w-full scale-105 object-cover object-center"
      />
    </picture>
    <!-- Gradientes de legibilidade -->
    <div class="absolute inset-0 bg-linear-to-t from-ink-950 via-ink-950/62 to-ink-950/25"></div>
    <div
      class="absolute inset-y-0 left-0 w-full bg-linear-to-r from-ink-950 via-ink-950/60 to-transparent lg:w-2/3 lg:via-ink-950/55"
    >
    </div>
    <!-- reforço para o texto de apoio no mobile -->
    <div class="absolute inset-0 bg-ink-950/35 lg:hidden"></div>
    <!-- scrim superior: mantém a navegação legível sobre a imagem -->
    <div class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-ink-950/85 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-ink-950 to-transparent"></div>
  </div>

  <!-- Brilho azul da marca -->
  <div
    aria-hidden="true"
    class="hero-glow-in pointer-events-none absolute top-1/2 left-1/2 z-0 h-[70vw] w-[70vw] max-w-[900px] max-h-[900px] -translate-x-1/2 -translate-y-2/3 rounded-full opacity-45 blur-[120px]"
    style="background: radial-gradient(circle, rgba(52,91,166,.75) 0%, rgba(52,91,166,.18) 45%, transparent 70%)"
  >
  </div>

  <!-- Grid técnico -->
  <div class="grid-lines pointer-events-none absolute inset-0 z-0 opacity-30" aria-hidden="true">
  </div>

  <div class="container-lp relative z-10">
    <div data-hero-content class="max-w-4xl">
      <h1 class="display-xl text-white">
        {
          hero.title.map((line, i) => (
            <span class="hero-line">
              <span style={`--d:${0.15 + i * 0.085}s`}>{line} </span>
            </span>
          ))
        }
      </h1>

      <p class="hero-rise lead mt-7 max-w-2xl text-white/80" style="--d:0.3s">
        {hero.subtitle}
      </p>

      <div class="hero-rise mt-10 flex flex-wrap items-center gap-3" style="--d:0.42s">
        <a href={hero.primaryCta.href} class="btn btn-primary" data-magnetic="0.18">
          <span>{hero.primaryCta.label}</span>
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-ghost-light" data-magnetic="0.14">
          <span>{hero.secondaryCta.label}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Ticker: largura total da página, de borda a borda. Fica fora do
       container para não parecer recortado nas laterais; as máscaras de fade
       nas duas pontas fazem a faixa entrar e sair sem corte seco. -->
  <div
    class="hero-fade relative z-10 mt-12 border-t border-white/8 pt-5 lg:mt-14"
    style="--d:0.55s"
  >
    <div class="flex items-center gap-6">
      <div data-marquee data-speed="34" class="relative min-w-0 flex-1 overflow-hidden">
        <div class="marquee-track items-center gap-3">
          {
            hero.ticker.map((item) => (
              <span class="flex shrink-0 items-center gap-3 pr-3">
                <span class="eyebrow rounded-full border border-white/10 bg-white/3 px-4 py-2 text-white/55">
                  {item}
                </span>
                <span class="h-1 w-1 rounded-full bg-brand-400/60" />
              </span>
            ))
          }
        </div>
        <div
          class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-linear-to-r from-ink-950 to-transparent lg:w-28"
        >
        </div>
        <div
          class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-linear-to-l from-ink-950 to-transparent lg:w-28"
        >
        </div>
      </div>

      <!-- Indicador de scroll, alinhado com o padding da página -->
      <div
        data-scroll-cue
        class="hidden shrink-0 items-center gap-3 pr-6 lg:flex lg:pr-10"
      >
        <span class="eyebrow text-white/35">Role</span>
        <span class="relative block h-9 w-px overflow-hidden bg-white/15">
          <span data-scroll-cue-bar class="absolute inset-0 block bg-brand-300"></span>
        </span>
      </div>
    </div>
  </div>
</section>
