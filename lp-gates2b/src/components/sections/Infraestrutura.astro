---
import { infraestrutura as c } from '../../data/content';
---

<section
  id="infraestrutura"
  class="texture relative overflow-hidden bg-ink-950 py-24 lg:py-36"
>
  <div class="grid-lines pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="container-lp relative">
    <div data-sticky-list class="grid gap-14 lg:grid-cols-[0.9fr_1fr] lg:gap-24">
      <!-- Coluna sticky -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 data-split="lines" class="display-lg text-white">{c.title}</h2>
        <div data-stagger-group class="mt-8 space-y-4">
          {
            c.paragraphs.map((p) => (
              <p data-anim="fade-up" class="text-base leading-relaxed font-light text-white/55">
                {p}
              </p>
            ))
          }
        </div>

        <!-- Índice ativo -->
        <div
          data-anim="fade"
          class="mt-12 hidden items-center gap-5 border-t border-white/8 pt-8 lg:flex"
        >
          <span
            data-sticky-index
            class="font-display text-6xl leading-none font-medium tracking-tighter text-brand-400"
            >01</span
          >
          <span class="eyebrow max-w-[9rem] text-white/30">
            de {String(c.items.length).padStart(2, '0')} pilares da infraestrutura
          </span>
        </div>
      </div>

      <!-- Lista com item ativo -->
      <div class="lg:pt-4">
        {
          c.items.map((item, i) => (
            <div
              data-sticky-item
              class="sticky-item group relative border-t border-white/8 py-8 last:border-b lg:py-12"
            >
              <span class="sticky-rail absolute top-0 left-0 h-px w-full origin-left scale-x-0 bg-linear-to-r from-brand-400 via-brand-500 to-transparent transition-transform duration-700" />
              <div class="flex items-start gap-6 lg:gap-10">
                <span class="eyebrow mt-2 shrink-0 text-white/20 transition-colors duration-500 group-[.is-active]:text-brand-300">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-2xl leading-tight font-medium tracking-tight text-white/45 transition-colors duration-500 group-[.is-active]:text-white lg:text-[2rem]">
                    {item.title}
                  </h3>
                  <p class="mt-3 max-w-md text-[0.9375rem] leading-relaxed font-light text-white/35 transition-colors duration-500 group-[.is-active]:text-white/65">
                    {item.description}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .sticky-item.is-active .sticky-rail {
    transform: scaleX(1);
  }
</style>
