---
import { paraQuem as c } from '../../data/content';
---

<section
  id="para-quem"
  data-theme-section="light"
  class="relative overflow-hidden bg-paper py-24 text-ink-950 lg:py-36"
>
  <div class="container-lp relative">
    <div class="max-w-3xl">
      <h2 data-split="lines" class="display-lg text-ink-950">{c.title}</h2>
    </div>
  </div>

  <!-- Faixa infinita de segmentos. É decorativa: os mesmos cinco segmentos
       aparecem logo abaixo, em cards legíveis. Fica fora da árvore de
       acessibilidade para não duplicar conteúdo para leitores de tela. -->
  <div
    data-marquee
    data-speed="42"
    aria-hidden="true"
    class="relative mt-14 overflow-hidden border-y border-ink-950/8 py-6 lg:mt-20"
  >
    <div class="marquee-track items-center gap-8 lg:gap-12">
      {
        c.items.map((item) => (
          <span class="flex shrink-0 items-center gap-8 lg:gap-12">
            <!-- 44%: é o mínimo que garante 3:1 sobre branco em texto grande (WCAG AA).
                 A 41% o contraste dá 2,85 e reprova por pouco. -->
            <span class="font-display text-[clamp(1.75rem,3.4vw,3rem)] leading-none font-medium tracking-[-0.04em] whitespace-nowrap text-ink-950/44 transition-colors duration-500 hover:text-ink-950">
              {item.title}
            </span>
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
          </span>
        ))
      }
    </div>
  </div>

  <div class="container-lp relative">
    {/* Cinco itens em grade de três colunas deixavam um buraco na segunda
        linha. Numa grade de seis colunas, as três primeiras cartas ocupam duas
        colunas cada e as duas últimas ocupam três: as duas linhas fecham
        cheias, e a diferença de largura entre elas lê como composição, não
        como sobra. */}
    <div
      data-stagger-group="0.08"
      class="mt-14 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-6"
    >
      {
        c.items.map((item, i) => (
          <article
            data-anim="fade-up"
            class:list={[
              // altura mínima igual nas duas linhas: sem isso a linha de baixo,
              // com descrições mais curtas, fica visivelmente mais baixa
              'card-light group flex flex-col p-7 lg:min-h-[11.5rem] lg:p-8',
              i < 3 ? 'lg:col-span-2' : 'lg:col-span-3',
              // no tablet a quinta carta ocupa a linha inteira, pelo mesmo motivo
              i === 4 ? 'sm:col-span-2 lg:col-span-3' : '',
            ]}
          >
            <div class="flex items-center gap-4">
              <span class="font-display text-lg leading-none font-semibold tracking-tight text-brand-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="h-px w-8 bg-brand-500/30 transition-all duration-500 group-hover:w-14 group-hover:bg-brand-500" />
            </div>

            <h3 class="mt-7 font-display text-xl font-medium tracking-tight text-ink-950 lg:text-2xl">
              {item.title}
            </h3>
            <p class="mt-3 max-w-sm text-[0.9375rem] leading-relaxed text-ink-950/60">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
