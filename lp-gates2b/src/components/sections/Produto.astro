---
import { produto as c } from '../../data/content';
import Icon from '../Icon.astro';
---

<section
  id="produto"
  data-theme-section="light"
  class="relative overflow-hidden bg-paper py-24 text-ink-950 lg:py-36"
>
  <div
    class="grid-lines-light pointer-events-none absolute inset-0 opacity-60"
    aria-hidden="true"
  >
  </div>

  <div class="container-lp relative">
    <div class="grid gap-14 lg:grid-cols-[0.95fr_1fr] lg:gap-20">
      <div>
        <h2 data-split="lines" class="display-lg text-ink-950">{c.title}</h2>
      </div>

      <div data-stagger-group class="flex flex-col justify-end gap-5 lg:pb-2">
        {
          c.paragraphs.map((p, i) => (
            <p
              data-anim="fade-up"
              class:list={[
                'leading-relaxed',
                i === 0
                  ? 'text-lg font-normal text-ink-950 lg:text-xl'
                  : 'text-base font-light text-ink-950/60',
              ]}
            >
              {p}
            </p>
          ))
        }
      </div>
    </div>

    <!-- Cards de recursos -->
    <div
      data-stagger-group="0.1"
      class="mt-16 grid gap-5 sm:grid-cols-2 lg:mt-24 lg:grid-cols-4"
    >
      {
        c.features.map((f, i) => (
          <article
            data-anim="fade-up"
            data-tilt="4"
            class="card-light group relative flex flex-col justify-between overflow-hidden p-7 lg:min-h-[19rem]"
          >
            <div
              data-tilt-glow
              aria-hidden="true"
              class="pointer-events-none absolute -inset-24 opacity-0 blur-3xl transition-opacity duration-500"
              style="background: radial-gradient(circle at center, rgba(52,91,166,.18), transparent 60%)"
            />
            <div class="relative">
              <div
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-500 transition-colors duration-500 group-hover:bg-brand-500 group-hover:text-white"
              >
                <Icon name={f.icon} class="h-5 w-5" />
              </div>
              <span class="eyebrow mt-6 block text-ink-950/25">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="relative mt-8">
              <h3 class="font-display text-xl font-medium tracking-tight text-ink-950">
                {f.title}
              </h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed font-light text-ink-950/55">
                {f.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
