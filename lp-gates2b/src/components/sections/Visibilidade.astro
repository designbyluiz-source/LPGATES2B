---
import { visibilidade as c } from '../../data/content';
---

<section id="visibilidade" class="texture relative overflow-hidden bg-ink-900 py-24 lg:py-36">
  <div
    class="grid-lines pointer-events-none absolute inset-0 opacity-50"
    aria-hidden="true"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full opacity-45 blur-[130px]"
    style="background: radial-gradient(circle, rgba(52,91,166,.55), transparent 68%)"
  >
  </div>

  <div class="container-lp relative">
    <div class="max-w-3xl">
      <h2 data-split="lines" class="display-lg text-white">{c.title}</h2>
      <p data-anim="fade-up" class="lead mt-7 max-w-2xl text-white/60">{c.description}</p>
    </div>

    <!-- Console operacional -->
    <div
      data-anim="scale-in"
      class="mt-14 overflow-hidden rounded-2xl border border-white/10 bg-ink-850/80 backdrop-blur-xl lg:mt-20"
    >
      <!-- Barra do console -->
      <div
        class="flex items-center justify-between gap-4 border-b border-white/8 bg-white/2 px-5 py-3.5"
      >
        <div class="flex items-center gap-3">
          <img width="403" height="427" src="/logos/icone-branco.svg" alt="" aria-hidden="true" class="h-4 w-auto opacity-70" />
          <span class="font-mono text-[0.6875rem] tracking-wider text-white/40">
            gates2b · console operacional
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-300"></span>
          <span class="eyebrow text-white/35">tempo real</span>
        </div>
      </div>

      <div class="grid lg:grid-cols-[1.15fr_1fr]">
        <!-- Módulos -->
        <div data-modules class="grid grid-cols-2 gap-px bg-white/6 sm:grid-cols-2">
          {
            c.modules.map((m) => (
              <div
                data-module
                class="module group relative bg-ink-850 p-5 transition-colors duration-500 lg:p-6"
              >
                <div class="flex items-start justify-between gap-2">
                  <span class="eyebrow text-white/35 transition-colors duration-500 group-[.is-live]:text-brand-300">
                    {m.label}
                  </span>
                  <span class="module-dot mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-white/15 transition-all duration-500" />
                </div>
                <p class="mt-3 font-display text-lg leading-none font-medium tracking-tight text-white lg:text-xl">
                  {m.metric}
                </p>
                <p class="mt-1.5 font-mono text-[0.6875rem] text-white/30">{m.delta}</p>
                <span class="module-bar absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-linear-to-r from-brand-400 to-transparent transition-transform duration-700" />
              </div>
            ))
          }
        </div>

        <!-- Fluxo de eventos -->
        <div class="border-t border-white/8 bg-ink-900/60 lg:border-t-0 lg:border-l">
          <div class="flex items-center justify-between border-b border-white/8 px-5 py-3.5">
            <span class="eyebrow text-white/40">Fluxo de eventos</span>
            <span class="font-mono text-[0.6875rem] text-white/25">webhooks · v1</span>
          </div>
          <div data-stream class="divide-y divide-white/5">
            {
              c.stream.map((e) => (
                <div
                  data-stream-row
                  class="flex items-center justify-between gap-4 px-5 py-3.5 transition-colors duration-300 hover:bg-white/2"
                >
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="h-1 w-1 shrink-0 rounded-full bg-brand-400" />
                    <span class="truncate font-mono text-[0.75rem] text-white/65">{e.type}</span>
                  </div>
                  <div class="flex shrink-0 items-center gap-3">
                    <span class="font-mono text-[0.75rem] text-white/40">{e.value}</span>
                    <span class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-[0.625rem] text-white/35">
                      {e.country}
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .module.is-live {
    background: color-mix(in srgb, var(--color-brand-500) 12%, var(--color-ink-850));
  }
  .module.is-live .module-dot {
    background: var(--color-brand-300);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand-400) 22%, transparent);
  }
  .module.is-live .module-bar {
    transform: scaleX(1);
  }
</style>
